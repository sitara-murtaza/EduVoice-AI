# Vercel frontend. Set to the deployed Cloudflare Worker origin, with no /api suffix.
CLOUDFLARE_API_URL=

# Cloudflare Worker secrets/variables (never commit real values).
# Set FRONTEND_ORIGIN to the exact public Vercel origin, without a trailing slash.
FRONTEND_ORIGIN=
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Account-free guest access; site key is public, secret values stay in the Worker.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GUEST_SESSION_SECRET=
# Only needed if choosing Supabase accounts instead of guest access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
