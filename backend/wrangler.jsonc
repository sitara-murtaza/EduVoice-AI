{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "eduvoice-api",
  "main": "index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    { "name": "GLOBAL_AI_LIMITER", "namespace_id": "1102", "simple": { "limit": 100, "period": 60 } }
  ]
}
